	partition Deliveries = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents("https://raw.githubusercontent.com/lidianarhoro88/pharma-distribution-dbt/main/powerbi/data/Deliveries.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"delivered_at", "lead_time_hours", "is_on_time", "is_otif"}),
				    Typed = Table.TransformColumnTypes(Blanks, {{"order_id", type text}, {"order_date", type date}, {"pharmacy_code", type text}, {"warehouse", type text}, {"carrier", type text}, {"has_cold_chain", type logical}, {"dispatched_at", type datetime}, {"promised_at", type datetime}, {"delivered_at", type datetime}, {"is_delivered", type logical}, {"lead_time_hours", type number}, {"is_on_time", type logical}, {"is_in_full", type logical}, {"is_otif", type logical}}, "en-US")
				in
				    Typed

