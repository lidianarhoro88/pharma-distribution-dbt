table Deliveries
	lineageTag: 8ee41e70-1400-1a66-b76d-a566422b2f83

	measure 'Delivered Orders' = CALCULATE ( COUNTROWS ( Deliveries ), Deliveries[is_delivered] = TRUE () )
		formatString: #,0
		displayFolder: Delivery
		lineageTag: 24b98c21-b378-29e7-d9d7-eaf8aab1221f

	measure 'On-Time %' = DIVIDE ( CALCULATE ( COUNTROWS ( Deliveries ), Deliveries[is_delivered] = TRUE (), Deliveries[is_on_time] = TRUE () ), [Delivered Orders] )
		formatString: 0.0%
		displayFolder: Delivery
		lineageTag: 5e75dfd7-af1b-878a-5a81-0e2453a0e3d0

	measure 'OTIF %' = DIVIDE ( CALCULATE ( COUNTROWS ( Deliveries ), Deliveries[is_delivered] = TRUE (), Deliveries[is_otif] = TRUE () ), [Delivered Orders] )
		formatString: 0.0%
		displayFolder: Delivery
		lineageTag: 899fa9ae-6224-a05b-45e0-ee8d9c778fb6

	measure 'Avg Lead Time (h)' = CALCULATE ( AVERAGE ( Deliveries[lead_time_hours] ), Deliveries[is_delivered] = TRUE () )
		formatString: 0.0
		displayFolder: Delivery
		lineageTag: 4194ee46-66be-f916-b072-6ce31ff8883f

	measure 'On-Time Target' = 0.90
		formatString: 0%
		displayFolder: Delivery
		lineageTag: d1d5cc84-c7d8-75c3-c22b-5f72f455aac4

	measure 'On-Time Gap to Target' = [On-Time %] - [On-Time Target]
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Delivery
		lineageTag: 23417247-2e80-a2d7-6df6-29c509e8375a

