	partition OrderLines = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents("https://raw.githubusercontent.com/lidianarhoro88/pharma-distribution-dbt/main/powerbi/data/OrderLines.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"line_id", Int64.Type}, {"order_id", type text}, {"order_date", type date}, {"pharmacy_code", type text}, {"sku", type text}, {"warehouse", type text}, {"order_status", type text}, {"is_cancelled", type logical}, {"quantity", Int64.Type}, {"unit_price_try", type number}, {"discount_pct", type number}, {"gross_amount_try", type number}, {"net_amount_try", type number}, {"returned_quantity", Int64.Type}, {"expired_quantity", Int64.Type}, {"returned_amount_try", type number}, {"net_after_returns_try", type number}}, "en-US")
				in
				    Typed

