table OrderLines
	lineageTag: 1e5f70fb-a754-83ce-0434-c9a2a68fe4cf

	measure 'Net Sales' = CALCULATE ( SUM ( OrderLines[net_amount_try] ), OrderLines[is_cancelled] = FALSE () )
		formatString: ₺#,0
		displayFolder: Sales
		lineageTag: 30085924-8430-a931-a1dd-9d2b10e410f1

	measure 'Returns Value' = CALCULATE ( SUM ( OrderLines[returned_amount_try] ), OrderLines[is_cancelled] = FALSE () )
		formatString: ₺#,0
		displayFolder: Sales
		lineageTag: 7fa7ff5d-f3d8-a2ec-eb7f-a92d84d90745

	measure 'Return Rate %' = DIVIDE ( [Returns Value], [Net Sales] )
		formatString: 0.00%
		displayFolder: Sales
		lineageTag: a2c61491-e605-a1c5-2175-8aa28911a2b0

	measure 'Orders' = CALCULATE ( DISTINCTCOUNT ( OrderLines[order_id] ), OrderLines[is_cancelled] = FALSE () )
		formatString: #,0
		displayFolder: Sales
		lineageTag: 98957d82-4f31-2293-1a9c-391f7cce5d97

	measure 'Cancelled Orders' = CALCULATE ( DISTINCTCOUNT ( OrderLines[order_id] ), OrderLines[is_cancelled] = TRUE () )
		formatString: #,0
		displayFolder: Sales
		lineageTag: fa257427-5ca0-14f7-3343-98c291d5c994

	measure 'Cancellation Rate %' = DIVIDE ( [Cancelled Orders], [Orders] + [Cancelled Orders] )
		formatString: 0.0%
		displayFolder: Sales
		lineageTag: 2f52c0be-1d4a-3f12-06e2-0ee762236d31

	measure 'Active Pharmacies' = CALCULATE ( DISTINCTCOUNT ( OrderLines[pharmacy_code] ), OrderLines[is_cancelled] = FALSE () )
		formatString: #,0
		displayFolder: Sales
		lineageTag: 4c6012dd-f47f-9006-e350-3b583a54d4e6

	measure 'Avg Order Value' = DIVIDE ( [Net Sales], [Orders] )
		formatString: ₺#,0
		displayFolder: Sales
		lineageTag: c69457a5-5f47-4ee3-4c1b-150cb725e5a3

	measure 'Net Sales PM' = CALCULATE ( [Net Sales], DATEADD ( 'Calendar'[date_day], -1, MONTH ) )
		formatString: ₺#,0
		displayFolder: Sales
		lineageTag: 292b4bd7-73f1-65b7-1ecb-46c2ec1aa4ef

	measure 'Net Sales MoM %' = DIVIDE ( [Net Sales] - [Net Sales PM], [Net Sales PM] )
		formatString: 0.0%
		displayFolder: Sales
		lineageTag: ee60d2d2-ef13-39b5-729a-793d4cb0a96f

	measure 'Expired Units' = CALCULATE ( SUM ( OrderLines[expired_quantity] ), OrderLines[is_cancelled] = FALSE () )
		formatString: #,0
		displayFolder: Expiry
		lineageTag: b7036f11-d312-52f0-824b-aef98a9b7f9e

	measure 'Expired Value' = CALCULATE ( SUMX ( OrderLines, OrderLines[expired_quantity] * OrderLines[unit_price_try] * ( 1 - OrderLines[discount_pct] / 100 ) ), OrderLines[is_cancelled] = FALSE () )
		formatString: ₺#,0
		displayFolder: Expiry
		lineageTag: 1076ae9d-7c33-9952-768a-6416062e4f2c

	measure 'Expiry Rate %' = DIVIDE ( [Expired Units], CALCULATE ( SUM ( OrderLines[quantity] ), OrderLines[is_cancelled] = FALSE () ) )
		formatString: 0.00%
		displayFolder: Expiry
		lineageTag: 6ae3143e-2a2d-30ef-8bd4-e3fab5765377

	measure 'Top 10 SKU Share of Expiry' = VAR Top10 = TOPN ( 10, ALL ( Product[sku] ), [Expired Value] ) RETURN DIVIDE ( CALCULATE ( [Expired Value], Top10 ), CALCULATE ( [Expired Value], ALL ( Product ) ) )
		formatString: 0.0%
		displayFolder: Expiry
		lineageTag: a675982b-67a2-7634-255c-116e8ad3f170

