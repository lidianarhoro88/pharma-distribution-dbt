		sourceColumn: sku

	column product_name
		dataType: string
		lineageTag: 6eacd874-6c2c-55d0-56e4-68e355e39fb8
		summarizeBy: none
		sourceColumn: product_name

	column atc_group
		dataType: string
		lineageTag: ecec0227-468f-ad76-b097-278e59b32d5b
		summarizeBy: none
		sourceColumn: atc_group

	column atc_group_name
		dataType: string
		lineageTag: 5378a407-f2fa-5574-52a5-5088a725629f
		summarizeBy: none
