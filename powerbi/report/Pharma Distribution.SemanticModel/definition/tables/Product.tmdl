		summarizeBy: none
		sourceColumn: list_price_try

	partition Product = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents("https://raw.githubusercontent.com/lidianarhoro88/pharma-distribution-dbt/main/powerbi/data/Product.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"sku", type text}, {"product_name", type text}, {"atc_group", type text}, {"atc_group_name", type text}, {"is_cold_chain", type logical}, {"list_price_try", type number}}, "en-US")
				in
				    Typed

